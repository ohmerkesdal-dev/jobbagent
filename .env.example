# Påkrevd for analyse (sett i Vercel → Environment Variables)
ANTHROPIC_API_KEY=

# Valgfri: standard er claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe Payment Link / Checkout URL (MVP: kan være en plassholder)
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=https://stripe.com

# Brave Search API (nett/LinkedIn / selskap) — hent nøkkel fra https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Valgfritt: sett til false for å skru av nett-søk (NAV skannes fortsatt).
# JOBBAGENT_WEB_SCAN_ENABLED=false

# NAV Ledige stillinger — valgfri base-URL for GET ?size=&q= (standard: arbeidsplassen.nav.no/api/v2/ads).
# Ved 404 fra Next på rot-domenet brukes automatisk pam-stilling-feed som reserve.
# NAV_JOBS_API_URL=https://arbeidsplassen.nav.no/api/v2/ads
